{
  "name": "recharza-platform",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:verify:foundation": "node scripts/verify-database-foundation.mjs",
    "env:use-neon": "node scripts/configure-neon-env.mjs",
    "deploy:check": "node scripts/validate-deployment-env.mjs",
    "deploy:prepare": "npm run deploy:check && npm run db:deploy",
    "support:telegram:webhook": "node scripts/configure-telegram-support-webhook.mjs",
    "staff:set-password": "tsx scripts/set-staff-password.ts",
    "ops:rollout:termux": "bash scripts/termux-phase1-rollout.sh",
    "smoke": "node scripts/smoke-test.mjs",
    "smoke:phase1": "node scripts/phase1-smoke-test.mjs"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "dotenv": "^17.0.0",
    "google-auth-library": "^10.5.0",
    "hash-wasm": "^4.12.0",
    "lucide-react": "^1.31.0",
    "next": "16.2.10",
    "pg": "^8.0.0",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "latest",
    "@types/pg": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "eslint": "latest",
    "eslint-config-next": "16.2.10",
    "postcss": "latest",
    "prisma": "^7.0.0",
    "tailwindcss": "4.3.3",
    "tsx": "^4.19.0",
    "typescript": "latest"
  },
  "engines": {
    "node": "24.x"
  }
}
