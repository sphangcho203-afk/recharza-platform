generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OrderStatus {
  CREATED
  AWAITING_PAYMENT
  PAYMENT_PENDING
  PAID
  FULFILLING
  COMPLETED
  FAILED
  CANCELLED
}

enum WebhookStatus {
  RECEIVED
  PROCESSED
  IGNORED
  FAILED
}

enum SupplierSyncStatus {
  RUNNING
  COMPLETED
  FAILED
}

enum AccountRole {
  CUSTOMER
  STAFF
  ADMIN
}

enum AccountAccessStatus {
  ACTIVE
  ORDER_RESTRICTED
  SIGN_IN_RESTRICTED
  SUSPENDED
}

enum AuthTokenPurpose {
  SIGN_IN
}

enum FulfilmentStatus {
  PLANNED
  SUBMITTING
  SUBMITTED
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum FulfilmentMode {
  DRY_RUN
  SUPPLIER_WRITE
}

enum MediaAssetKind {
  GENERAL
  BRAND
  GAME_LOGO
  GAME_ARTWORK
  BANNER
  SOCIAL
  PRODUCT
}

enum MediaAssetStatus {
  DRAFT
  REVIEW
  APPROVED
  ARCHIVED
}

enum EmailDeliveryStatus {
  PENDING
  SENT
  FAILED
}

enum EmailMessageKind {
  ACCOUNT_CREATED
  PASSWORD_RESET
  PASSWORD_CHANGED
  ORDER_COMPLETED
  ORDER_FAILED
}

model Customer {
  id                         String              @id @default(cuid())
  email                      String              @unique
  displayName                String?
  username                   String?             @unique
  passwordHash               String?
  passwordUpdatedAt          DateTime?
  role                       AccountRole         @default(CUSTOMER)
  accessStatus               AccountAccessStatus @default(ACTIVE)
  restrictionReason          String?
  restrictionUpdatedAt       DateTime?
  staffPermissions           String[]            @default([])
  staffPermissionsConfigured Boolean             @default(false)
  authSubject                String?             @unique
  emailVerifiedAt            DateTime?
  lastLoginAt                DateTime?
  createdAt                  DateTime             @default(now())
  updatedAt                  DateTime             @updatedAt
  orders                     Order[]
  addresses                  CustomerAddress[]
  sessions                   AuthSession[]
  magicLinks                 AuthMagicLink[]
  passwordResetTokens        PasswordResetToken[]
  carts                      Cart[]
  emailDeliveries            EmailDelivery[]
  staffCredential            StaffCredential?
  staffSessions              StaffSession[]
  staffAuditLogs             AdminAuditLog[]      @relation("StaffAuditActor")
  mediaAssets                MediaAsset[]         @relation("MediaAssetCreator")
  supportTickets             SupportTicket[]      @relation("SupportTicketRequester")
  assignedSupportTickets     SupportTicket[]      @relation("SupportTicketAssignee")

  @@index([role, accessStatus, createdAt])
  @@index([username])
}

model CustomerAddress {
  id          String   @id @default(cuid())
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  fullName    String
  email       String
  phone       String
  line1       String
  line2       String?
  city        String
  state       String
  postalCode  String
  countryCode String
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([customerId, isDefault])
  @@index([customerId, createdAt])
}

model StaffCredential {
  id                 String         @id @default(cuid())
  customerId         String         @unique
  customer           Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  passwordHash       String
  passwordVersion    Int            @default(1)
  mustChangePassword Boolean        @default(false)
  failedLoginCount   Int            @default(0)
  lockedUntil        DateTime?
  lastFailedLoginAt  DateTime?
  lastLoginAt        DateTime?
  passwordChangedAt  DateTime       @default(now())
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  sessions           StaffSession[]

  @@index([lockedUntil])
}

model StaffSession {
  id                String          @id @default(cuid())
  tokenHash         String          @unique
  customerId        String
  customer          Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  credentialId      String
  credential        StaffCredential @relation(fields: [credentialId], references: [id], onDelete: Cascade)
  passwordVersion   Int
  idleExpiresAt     DateTime
  absoluteExpiresAt DateTime
  lastUsedAt        DateTime        @default(now())
  revokedAt         DateTime?
  userAgentHash     String?
  createdAt         DateTime        @default(now())

  @@index([customerId, revokedAt, absoluteExpiresAt])
  @@index([credentialId, revokedAt])
  @@index([idleExpiresAt, absoluteExpiresAt, revokedAt])
}

model AuthSession {
  id            String   @id @default(cuid())
  tokenHash     String   @unique
  customerId    String
  customer      Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  expiresAt     DateTime
  lastUsedAt    DateTime @default(now())
  revokedAt     DateTime?
  userAgentHash String?
  createdAt     DateTime @default(now())

  @@index([customerId, expiresAt])
  @@index([expiresAt, revokedAt])
}

model AuthMagicLink {
  id                   String           @id @default(cuid())
  tokenHash            String           @unique
  purpose              AuthTokenPurpose @default(SIGN_IN)
  customerId           String
  customer             Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  requestedFingerprint String
  expiresAt            DateTime
  usedAt               DateTime?
  createdAt            DateTime         @default(now())

  @@index([customerId, createdAt])
  @@index([expiresAt, usedAt])
}

model PasswordResetToken {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  customerId String
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([customerId, createdAt])
  @@index([expiresAt, usedAt])
}

model Cart {
  id           String     @id @default(cuid())
  customerId   String?
  customer     Customer?  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  guestKeyHash String?    @unique
  status       String     @default("ACTIVE")
  items        CartItem[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([customerId, status, updatedAt])
  @@index([status, updatedAt])
}

model CartItem {
  id               String   @id @default(cuid())
  cartId           String
  cart             Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  gameSlug         String
  marketCode       String?
  packageId        String
  packageName      String
  amountInPaise    Int
  currency         String   @default("INR")
  quantity         Int      @default(1)
  playerId         String?
  zoneId           String?
  verifiedNickname String?
  verificationMode String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([cartId, createdAt])
  @@index([gameSlug, marketCode, packageId])
}

model Order {
  id                      String      @id @default(cuid())
  publicId                String      @unique
  idempotencyKey          String      @unique
  checkoutBatchId         String?
  accessTokenHash         String
  status                  OrderStatus @default(CREATED)
  gameSlug                String
  marketCode              String?
  packageId               String
  packageName             String
  amountInPaise           Int
  currency                String      @default("INR")
  presentmentCurrency     String      @default("INR")
  presentmentAmountMinor  Int?
  fxRateFromInrMicros     Int?
  fxQuotedAt              DateTime?
  billingName             String?
  billingEmail            String?
  billingPhone            String?
  billingLine1            String?
  billingLine2            String?
  billingCity             String?
  billingState            String?
  billingPostalCode       String?
  billingCountryCode      String?
  playerId                String
  zoneId                  String
  verificationMode        String
  verifiedNickname        String?
  paymentProvider         String?
  paymentSessionId        String?     @unique
  supplierProductId       String?
  supplierCategoryId      String?
  supplierOfferId         String?
  customerId              String
  customer                Customer    @relation(fields: [customerId], references: [id], onDelete: Restrict)
  supplierProduct         SupplierProduct? @relation(fields: [supplierProductId], references: [id], onDelete: SetNull)
  events                  OrderEvent[]
  webhooks                PaymentWebhook[]
  auditLogs               AdminAuditLog[]
  fulfilmentAttempts      FulfilmentAttempt[]
  emailDeliveries         EmailDelivery[]
  supportTickets          SupportTicket[]
  createdAt               DateTime    @default(now())
  updatedAt               DateTime    @updatedAt

  @@index([customerId, createdAt])
  @@index([checkoutBatchId, createdAt])
  @@index([playerId, zoneId, createdAt])
  @@index([status, createdAt])
  @@index([supplierProductId])
  @@index([gameSlug, marketCode, createdAt])
  @@index([billingCountryCode, presentmentCurrency, createdAt])
}

model OrderEvent {
  id        String   @id @default(cuid())
  type      String
  message   String
  metadata  Json?
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([orderId, createdAt])
}

model EmailDelivery {
  id                String              @id @default(cuid())
  kind              EmailMessageKind
  recipient         String
  subject           String
  status            EmailDeliveryStatus @default(PENDING)
  providerMessageId String?
  errorMessage      String?
  payload           Json?
  attempts          Int                 @default(0)
  customerId        String?
  customer          Customer?           @relation(fields: [customerId], references: [id], onDelete: SetNull)
  orderId           String?
  order             Order?              @relation(fields: [orderId], references: [id], onDelete: SetNull)
  sentAt            DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@index([status, createdAt])
  @@index([customerId, createdAt])
  @@index([orderId, createdAt])
  @@index([recipient, createdAt])
}

model PaymentWebhook {
  id           String        @id @default(cuid())
  provider     String
  eventId      String?
  eventType    String
  payloadHash  String        @unique
  payload      Json
  status       WebhookStatus @default(RECEIVED)
  errorMessage String?
  orderId      String?
  order        Order?        @relation(fields: [orderId], references: [id], onDelete: SetNull)
  receivedAt   DateTime      @default(now())
  processedAt  DateTime?

  @@unique([provider, eventId], name: "provider_event_id")
  @@index([status, receivedAt])
  @@index([orderId, receivedAt])
}

model AdminAuditLog {
  id               String    @id @default(cuid())
  action           String
  actorFingerprint String
  actorCustomerId  String?
  actorCustomer    Customer? @relation("StaffAuditActor", fields: [actorCustomerId], references: [id], onDelete: SetNull)
  metadata         Json?
  orderId          String?
  order             Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  createdAt        DateTime  @default(now())

  @@index([actorCustomerId, createdAt])
  @@index([orderId, createdAt])
  @@index([createdAt])
}

model PricingConfiguration {
  id                   String   @id @default("default")
  usdInrRatePaise      Int      @default(9650)
  fxBufferBps          Int      @default(250)
  gatewayFeeBps        Int      @default(250)
  targetMarginBps      Int      @default(1200)
  minimumMarginInPaise Int      @default(1500)
  overheadInPaise      Int      @default(500)
  roundingInPaise      Int      @default(500)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model SupplierProduct {
  id                     String   @id @default(cuid())
  provider               String
  categoryId             String
  offerId                String
  gameSlug               String
  name                   String
  region                 String?
  supplierCurrency       String   @default("USD")
  supplierPriceUsdMicros Int
  landedCostInPaise      Int
  retailPriceInPaise     Int
  expectedMarginInPaise  Int
  expectedMarginBps      Int
  available              Boolean  @default(true)
  published              Boolean  @default(false)
  fields                 Json?
  raw                    Json?
  syncedAt               DateTime @default(now())
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  orders                 Order[]

  @@unique([provider, categoryId, offerId], name: "provider_category_offer")
  @@index([gameSlug, published, available, retailPriceInPaise])
  @@index([provider, categoryId, available])
  @@index([syncedAt])
}

model SupplierSyncRun {
  id               String             @id @default(cuid())
  provider         String
  status           SupplierSyncStatus @default(RUNNING)
  categoriesSynced Int                @default(0)
  offersSynced     Int                @default(0)
  errorMessage     String?
  startedAt        DateTime           @default(now())
  completedAt      DateTime?

  @@index([provider, startedAt])
  @@index([status, startedAt])
}

model FulfilmentAttempt {
  id              String            @id @default(cuid())
  orderId         String
  order           Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider        String
  mode            FulfilmentMode
  status          FulfilmentStatus  @default(PLANNED)
  idempotencyKey  String            @unique
  providerOrderId String?           @unique
  requestPayload  Json?
  responsePayload Json?
  errorMessage    String?
  submittedAt     DateTime?
  completedAt     DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([orderId, createdAt])
  @@index([provider, status, createdAt])
}

model MediaAsset {
  id                  String           @id @default(cuid())
  name                String
  fileName            String
  mimeType            String
  byteSize            Int
  checksum            String           @unique
  data                Bytes
  kind                MediaAssetKind   @default(GENERAL)
  status              MediaAssetStatus @default(DRAFT)
  altText             String
  notes               String?
  tags                String[]         @default([])
  createdByCustomerId String?
  createdByCustomer   Customer?        @relation("MediaAssetCreator", fields: [createdByCustomerId], references: [id], onDelete: SetNull)
  placements          MediaPlacement[]
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@index([status, kind, createdAt])
  @@index([createdByCustomerId, createdAt])
}

model MediaPlacement {
  id           String     @id @default(cuid())
  placementKey String     @unique
  label        String
  assetId      String
  asset        MediaAsset @relation(fields: [assetId], references: [id], onDelete: Restrict)
  publishedAt  DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([assetId, updatedAt])
}

model RateLimitBucket {
  id          String   @id @default(cuid())
  fingerprint String
  route       String
  windowStart DateTime
  count       Int      @default(0)
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([fingerprint, route, windowStart], name: "rate_limit_bucket")
  @@index([expiresAt])
}

model SupportTicket {
  id                       String     @id
  publicId                 String     @unique
  status                   String     @default("OPEN")
  category                 String
  subject                  String
  description              String
  source                   String     @default("WEB")
  replyChannel             String
  requesterName            String?
  requesterEmail           String?
  telegramUsername         String?
  telegramUserId           String?
  telegramChatId           String?
  telegramConnectTokenHash String?    @unique
  orderPublicId            String?
  gameSlug                 String?
  customerId               String?
  orderId                  String?
  metadata                 Json?
  telegramDeliveryStatus   String     @default("PENDING")
  telegramSupportMessageId String?
  emailDeliveryStatus      String     @default("PENDING")
  emailProviderMessageId   String?
  telegramDeliveryError    String?
  emailDeliveryError       String?
  lastStaffReplyAt         DateTime?
  resolvedAt               DateTime?
  assigneeCustomerId       String?
  customer                 Customer?  @relation("SupportTicketRequester", fields: [customerId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  order                    Order?     @relation(fields: [orderId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  assignee                 Customer?  @relation("SupportTicketAssignee", fields: [assigneeCustomerId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  createdAt                DateTime   @default(now())
  updatedAt                DateTime   @updatedAt

  @@index([status, createdAt])
  @@index([customerId, createdAt])
  @@index([orderId, createdAt])
  @@index([telegramUserId, createdAt])
  @@index([assigneeCustomerId, status, createdAt])
}

model SupportBotSession {
  chatId         String   @id
  telegramUserId String
  category       String
  step           String
  subject        String?
  orderPublicId  String?
  description    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  expiresAt      DateTime

  @@index([expiresAt])
  @@index([telegramUserId, updatedAt])
}

model SupportTelegramUpdate {
  updateId    String   @id
  processedAt DateTime @default(now())

  @@index([processedAt])
}
