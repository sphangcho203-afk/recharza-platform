# Deployment identity: development, staging, or production.
DEPLOYMENT_ENV=development

# Public application URL. Hosted staging must use the deployed HTTPS URL, not localhost.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional post-deployment smoke-test target.
SMOKE_TEST_BASE_URL=
# Set true only when intentionally testing an incomplete deployment that may return 503 from /api/readiness.
SMOKE_ALLOW_UNREADY=false

# PostgreSQL database.
# Termux development uses the hosted Neon database because Prisma's migration engine does not support Android.
# Copy the pooled connection string from the Recherza TopUp project in Neon.
DATABASE_URL=postgresql://neondb_owner:password@ep-example-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Persistent-order security. Use separate random values of at least 32 characters.
ORDER_ACCESS_SECRET=
RATE_LIMIT_SALT=

# Emergency operator fallback and scheduled-maintenance gate.
# Normal operator access uses STAFF or ADMIN account sessions.
ADMIN_ACCESS_TOKEN=
CRON_SECRET=

# Reviewed staff role allowlists. Use comma-separated addresses.
AUTH_STAFF_EMAILS=
AUTH_ADMIN_EMAILS=

# Google OAuth web client. Keep the client secret and state secret server-side.
# Production callback: https://your-domain.example/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_STATE_SECRET=

# Email delivery.
# Gmail is the primary/default Recharza transport. Set EMAIL_DELIVERY_PROVIDER=resend only for an intentional fallback rollout.
EMAIL_DELIVERY_PROVIDER=gmail
# The authorized Google account must have Gmail API access with the gmail.send scope.
# GOOGLE_MAIL_CLIENT_ID/SECRET are optional when GOOGLE_CLIENT_ID/SECRET belong to the same OAuth client used to issue the refresh token.
# The refresh token is always server-only and required for Gmail delivery.
# Redeploy the hosted environment after changing any mail credential so the new value is loaded.
GOOGLE_MAIL_CLIENT_ID=
GOOGLE_MAIL_CLIENT_SECRET=
GOOGLE_MAIL_REFRESH_TOKEN=
# Optional sender account/alias. It must be an address the authorized Gmail account can send as.
GOOGLE_MAIL_FROM=recherzatopup@gmail.com

# Optional Resend transport. It is used only when EMAIL_DELIVERY_PROVIDER=resend is explicitly selected.
# For production Resend delivery, verify a domain and send from an address on that domain.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Public support channels. These values may be exposed to the browser.
NEXT_PUBLIC_SUPPORT_EMAIL=recherzatopup@gmail.com
# Username only, without @ or a t.me URL.
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=
# International digits only, without +, spaces, or punctuation.
NEXT_PUBLIC_WHATSAPP_SUPPORT_NUMBER=
# Username only, without @ or an instagram.com URL.
NEXT_PUBLIC_INSTAGRAM_USERNAME=

# Server-only support delivery. Never prefix secrets with NEXT_PUBLIC_.
SUPPORT_NOTIFICATION_EMAIL=recherzatopup@gmail.com
TELEGRAM_BOT_TOKEN=
# Use a separate random secret. Telegram sends it in X-Telegram-Bot-Api-Secret-Token.
TELEGRAM_WEBHOOK_SECRET=
# Private worker group or channel chat ID, commonly beginning with -100.
TELEGRAM_SUPPORT_CHAT_ID=
# Comma-separated numeric Telegram user IDs allowed to claim, resolve, and reply to tickets.
# Worker actions fail closed when this list is empty.
TELEGRAM_WORKER_USER_IDS=
# Optional separate secret for protected support diagnostics. Falls back to TELEGRAM_WEBHOOK_SECRET when empty.
# After changing this value in a hosted environment, redeploy before testing so the new secret is loaded.
SUPPORT_DIAGNOSTICS_SECRET=

# Customer-flow provider switches.
# Keep internal while building and testing the complete store flow.
# Change only when the external provider contract and credentials are ready.
# volsever enables live Game ID/IGN verification through the Volsever Game ID Checker API.
# Supported games: mobile-legends, free-fire, pubg-mobile, valorant, genshin-impact.
IGN_LOOKUP_PROVIDER=internal
PAYMENT_PROVIDER=internal
# Optional server-only outcome: completed or failed. Empty defaults to completed.
INTERNAL_PAYMENT_OUTCOME=completed

# Volsever Game ID Checker. Used only when IGN_LOOKUP_PROVIDER=volsever.
# Auth is the X-API-Key header with a Volsever portal API key. Keep the key server-side.
# Base URL confirmed from the Volsever contract: GET {base}/proxy/api/game/{slug}?id=..&zone=..
VOLSEVER_API_KEY=
VOLSEVER_API_BASE_URL=https://gate.volsever.com
# Optional bounded upstream timeout in milliseconds. Default 15000 when empty.
VOLSEVER_LOOKUP_TIMEOUT_MS=

# FazerCards B2B supplier integration. Keep every value server-side.
FAZERCARDS_API_KEY=
FAZERCARDS_API_BASE_URL=https://api.fzr.cards/api/v2
# Comma-separated category IDs reviewed for region, fields, and fulfilment compatibility.
# Synced offers remain unpublished when this allowlist is empty.
FAZERCARDS_PUBLISHED_CATEGORY_IDS=
# Optional comma-separated HTTPS hosts approved for supplier or administrator product media.
# Example: cdn.supplier.example,media.recharza.example
FAZERCARDS_MEDIA_HOSTS=
FAZERCARDS_ORDER_CREATE_PATH=
# Must contain {order_id} or :orderId when configured.
FAZERCARDS_ORDER_STATUS_PATH=
# Supplier writes remain disabled unless this is explicitly true AND the required paths are configured.
FAZERCARDS_ORDER_WRITES_ENABLED=false

# Optional live foreign-exchange source. The default uses Frankfurter v2 with INR as base.
# Keep this server-side. When unavailable, checkout safely falls back to INR display only.
FX_RATE_SOURCE_URL=https://api.frankfurter.dev/v2/rates

# Razorpay Checkout. Used only when PAYMENT_PROVIDER=razorpay.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_API_BASE_URL=https://api.razorpay.com/v1

# Never commit real credentials. Keep them in your deployment provider's encrypted secret store.
